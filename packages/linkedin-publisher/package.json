{
  "name": "@paladini/linkedin-publisher-mcp",
  "version": "0.1.0",
  "description": "Publish LinkedIn Articles from DEV.to via browser automation — Markdown formatting, draft-first, MCP tools.",
  "type": "module",
  "bin": {
    "linkedin-publisher-mcp": "dist/mcp-server.js",
    "linkedin-publisher": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "postinstall": "patchright install chromium || true"
  },
  "dependencies": {
    "patchright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paladini/publish-agents.git",
    "directory": "packages/linkedin-publisher"
  },
  "bugs": {
    "url": "https://github.com/paladini/publish-agents/issues"
  },
  "homepage": "https://github.com/paladini/publish-agents/tree/main/packages/linkedin-publisher#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": ["linkedin", "devto", "cross-post", "mcp", "patchright", "browser-automation", "publisher", "articles"],
  "author": "Fernando Paladini"
}
